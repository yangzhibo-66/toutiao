NEWS_PROVIDER=worldnewsapi
WORLD_NEWS_API_KEY=replace_with_your_worldnewsapi_key

# 手动触发 POST /api/news/sync 所需的管理 token（不配置则该接口返回 503 拒绝访问）
NEWS_SYNC_ADMIN_TOKEN=change_me_to_a_long_random_string
# 并发抓取的 feed 数上限（9 个分类并发抓取比顺序快数倍）
NEWS_SYNC_FETCH_CONCURRENCY=3

DASHSCOPE_API_KEY=replace_with_your_dashscope_key
DASHSCOPE_MODEL=qwen-max
# 每 IP 每小时允许的 AI 对话次数（防止匿名请求消耗额度）
AI_CHAT_RATE_LIMIT_PER_HOUR=20
# AI 问答支持"数据库优先"：命中站内新闻时自动注入上下文；
# 未配置 DASHSCOPE_API_KEY 时退化为纯站内新闻检索回答

# 登录/注册限流（按 IP，5 分钟窗口），防暴力破解与批量注册
LOGIN_RATE_LIMIT_PER_5MIN=20
REGISTER_RATE_LIMIT_PER_5MIN=10

# 数据库：默认使用项目内 SQLite（sqlite+aiosqlite:///news_app.db）
# 切换 MySQL 示例：mysql+aiomysql://user:password@127.0.0.1:3306/news_app?charset=utf8mb4
# DATABASE_URL=

# Redis 缓存：不配置或连不上时自动降级为进程内存缓存，可不部署
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# 允许的前端来源（逗号分隔），不配置则允许所有来源；生产环境建议显式配置
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
