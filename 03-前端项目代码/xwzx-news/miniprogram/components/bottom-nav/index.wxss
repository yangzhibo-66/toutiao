.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(213, 223, 238, 0.95);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 40rpx rgba(20, 45, 75, 0.12);
  backdrop-filter: blur(18rpx);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 88rpx;
  color: #7b879b;
  border-radius: 999rpx;
}

.nav-item.is-active {
  color: #1e75ff;
  background: rgba(30, 117, 255, 0.08);
}

.nav-icon {
  font-size: 26rpx;
  font-weight: 800;
}

.nav-text {
  font-size: 22rpx;
  font-weight: 700;
}
