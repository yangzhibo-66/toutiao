page {
  min-height: 100%;
  background: #f5f7fb;
  color: #1f2a37;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(30, 117, 255, 0.12), transparent 34%),
    linear-gradient(180deg, #f7f9fc 0%, #ffffff 240rpx, #f5f7fb 100%);
}

.hero-card,
.panel-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(213, 223, 238, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 48rpx rgba(25, 55, 88, 0.08);
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(30, 117, 255, 0.08);
}

.hero-tag {
  position: relative;
  z-index: 1;
  display: inline-block;
  margin-bottom: 12rpx;
  color: #1e75ff;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.hero-title,
.hero-desc {
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  margin-bottom: 10rpx;
  color: #16202f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-desc {
  color: #6c7b90;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  margin: 0 0 20rpx;
  color: #16202f;
  font-size: 32rpx;
  font-weight: 700;
}

.ghost-button,
.primary-button,
.danger-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #1e75ff, #4aa8ff);
  box-shadow: 0 16rpx 32rpx rgba(30, 117, 255, 0.2);
}

.ghost-button {
  color: #1e75ff;
  background: #ffffff;
  border: 1rpx solid #d8e4f4;
}

.danger-button {
  color: #ffffff;
  background: linear-gradient(135deg, #f25f5c, #ff8a7d);
}

.empty-card {
  padding: 52rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 10rpx;
  color: #233143;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  color: #7c8a9e;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-card {
  padding: 28rpx;
}

.form-item + .form-item {
  margin-top: 22rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #253244;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 24rpx 26rpx;
  color: #1d2939;
  font-size: 28rpx;
  background: #f8fbff;
  border: 1rpx solid #d8e4f4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 180rpx;
}

.form-hint {
  margin-top: 24rpx;
  color: #7d8b9f;
  font-size: 24rpx;
  line-height: 1.7;
}
