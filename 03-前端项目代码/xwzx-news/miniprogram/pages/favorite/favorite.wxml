<view class="page-shell">
  <view class="header-row" wx:if="{{list.length}}">
    <text class="section-title">收藏列表</text>
    <view class="ghost-button tiny-button" bindtap="clearAll">清空</view>
  </view>

  <view wx:if="{{list.length}}">
    <view wx:for="{{list}}" wx:key="id" class="favorite-item">
      <news-card item="{{item}}" mode="simple" bindtapcard="goToDetail"></news-card>
      <view class="delete-action" data-id="{{item.id}}" bindtap="removeItem">删除</view>
    </view>
  </view>

  <view wx:else class="panel-card empty-card">
    <text class="empty-title">还没有收藏内容</text>
    <text class="empty-desc">在新闻详情页点击“收藏”后，这里就会出现。</text>
  </view>
</view>
