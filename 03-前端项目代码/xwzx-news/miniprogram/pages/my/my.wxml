<view class="page-shell">
  <view class="hero-card profile-card" wx:if="{{loggedIn}}">
    <view class="profile-row">
      <image wx:if="{{userInfo.avatar}}" class="avatar-image" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <view wx:else class="avatar-fallback">{{avatarText}}</view>
      <view class="profile-copy">
        <text class="profile-tag">ACCOUNT</text>
        <text class="profile-name">{{userInfo.username}}</text>
        <text class="profile-desc">{{userInfo.bio || '欢迎回来，继续浏览你关心的新闻。'}}</text>
      </view>
    </view>
  </view>

  <view class="hero-card profile-card" wx:else>
    <view class="profile-row">
      <view class="avatar-fallback">{{avatarText}}</view>
      <view class="profile-copy">
        <text class="profile-tag">WELCOME</text>
        <text class="profile-name">还没有登录</text>
        <text class="profile-desc">登录后可以同步收藏、浏览历史和账号信息。</text>
      </view>
    </view>

    <view class="guest-actions">
      <view class="primary-button guest-button" bindtap="goLogin">去登录</view>
      <view class="ghost-button guest-button" bindtap="goRegister">去注册</view>
    </view>
  </view>

  <view class="panel-card menu-card">
    <view class="menu-item" bindtap="goFavorite">
      <text class="menu-icon">藏</text>
      <text class="menu-text">我的收藏</text>
    </view>
    <view class="menu-item" bindtap="goHistory">
      <text class="menu-icon">历</text>
      <text class="menu-text">浏览历史</text>
    </view>
    <view class="menu-item" wx:if="{{loggedIn}}" bindtap="logout">
      <text class="menu-icon danger">退</text>
      <text class="menu-text danger-text">退出登录</text>
    </view>
  </view>

  <bottom-nav active="my"></bottom-nav>
</view>
