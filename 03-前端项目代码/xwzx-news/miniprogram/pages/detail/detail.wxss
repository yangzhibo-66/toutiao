.detail-shell {
  padding-bottom: 48rpx;
}

.detail-head {
  padding: 28rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-title {
  flex: 1;
  color: #182231;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.45;
}

.favorite-chip {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 60rpx;
  line-height: 60rpx;
  color: #1e75ff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  background: rgba(30, 117, 255, 0.08);
  border-radius: 999rpx;
}

.favorite-chip.is-active {
  color: #ffffff;
  background: linear-gradient(135deg, #ff9f1c, #ffb84d);
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-top: 18rpx;
  color: #7a8798;
  font-size: 24rpx;
}

.detail-cover {
  margin-top: 20rpx;
  overflow: hidden;
}

.cover-image,
.cover-placeholder {
  width: 100%;
  height: 420rpx;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: #1e75ff;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
  background: linear-gradient(135deg, #dbeafe, #eff6ff);
}

.article-card {
  margin-top: 20rpx;
  padding: 30rpx 28rpx;
}

.article-paragraph {
  display: block;
  margin-bottom: 22rpx;
  color: #263445;
  font-size: 32rpx;
  line-height: 1.95;
  text-indent: 2em;
}

.article-paragraph.lead {
  color: #334155;
}

.article-paragraph:last-child {
  margin-bottom: 0;
}

.source-action {
  margin-top: 22rpx;
}

.related-block {
  margin-top: 30rpx;
}
