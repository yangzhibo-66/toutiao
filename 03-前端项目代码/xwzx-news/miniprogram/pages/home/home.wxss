.tabs-bar {
  display: flex;
  align-items: center;
  padding: 12rpx;
  margin-bottom: 24rpx;
}

.tabs-scroll {
  flex: 1;
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  color: #6f7d92;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.tab-item.is-active {
  color: #1e75ff;
  background: rgba(30, 117, 255, 0.1);
}

.more-action {
  flex-shrink: 0;
  width: 92rpx;
  height: 64rpx;
  line-height: 64rpx;
  color: #1e75ff;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.news-list {
  min-height: 400rpx;
}

.load-tip {
  padding: 24rpx 0 140rpx;
  color: #8d99ad;
  font-size: 24rpx;
  text-align: center;
}
